# Public browser configuration. Do not put service-role or other secrets here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Development values can use localhost. A production build requires HTTPS,
# non-local origins and generates matching Chrome host permissions.
VITE_WEB_APP_URL=http://localhost:3000
VITE_API_URL=http://localhost:8080

VITE_SENTRY_DSN=
