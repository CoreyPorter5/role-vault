# Public browser configuration. Do not put service-role or other secrets here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Development values can use localhost. A production build requires HTTPS,
# non-local origins and generates matching Chrome host permissions.
VITE_WEB_APP_URL=http://localhost:3000
VITE_API_URL=http://localhost:8080

# Public crash-reporting configuration. Production builds grant only the DSN's
# ingest origin; keep SENTRY_AUTH_TOKEN out of VITE_ variables and CI-only.
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=

# CI-only source-map upload configuration. These are read by Vite's build
# process but are not compiled into the extension.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=seeksync
SENTRY_PROJECT=your-extension-project
